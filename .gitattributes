* text=auto
.gitattributes text eol=lf

# Keep audited source and evidence text byte-stable across Windows and Unix.
*.py text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.md text eol=lf
*.tex text eol=lf
*.bib text eol=lf
*.cls text eol=lf
*.ldf text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf
*.txt text eol=lf

# Generated and submission artefacts are binary.
*.docx binary
*.gz binary
*.nii binary
*.npy binary
*.npz binary
*.pdf binary
*.png binary
*.pptx binary
*.pth binary
*.pt binary
*.zip binary

# Preserve byte-identical recovered Windows evidence (including CRLF/BOM).
evidence/rigorous_patient_split/per_case_*.csv -text
evidence/rigorous_patient_split/training_log_*.csv -text
evidence/rigorous_patient_split/checkpoint_manifest.json -text
evidence/rigorous_patient_split/environment.json -text
evidence/rigorous_patient_split/run_transcript.txt -text
evidence/rigorous_patient_split/RECOVERED_CLOSURE_SHA256SUMS.txt -text
evidence/rigorous_patient_split/recovered_collector_audit_report.json -text
evidence/rigorous_patient_split/posthoc_dataset_manifest.json -text
evidence/rigorous_patient_split/data_discovery_report.json -text
evidence/rigorous_patient_split/patient_split_seed42.json -text
evidence/rigorous_patient_split/summary_metrics.csv -text
evidence/rigorous_patient_split/summary_metrics.json -text

# Preserve the supplied full-cine result bundle byte-for-byte so its embedded
# artifact manifest remains valid after a fresh clone on every platform.
evidence/spatiotemporal_cine/raw/** -text whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol
